+/* local patch: TOP = ICR1 takes effect on write, as on real hardware */
+static void
+avr_timer_write_icr(
+		struct avr_t * avr,
+		avr_io_addr_t addr,
+		uint8_t v,
+		void * param)
+{
+	avr_timer_t * p = (avr_timer_t *)param;
+	avr_core_watch_write(avr, addr, v);
+	if (p->mode.top == avr_timer_wgm_reg_icr && p->cs_div_value)
+		avr_timer_reconfigure(p, 0);
+}
